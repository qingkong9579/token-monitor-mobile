<?xml version="1.0" encoding="utf-8"?>
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <!-- The logo is pre-scaled onto a transparent canvas (60% centered), so the
         bitmap drawable is used directly — a <scale> wrapper fails to render in
         adaptive-icon foregrounds. -->
    <foreground android:drawable="@drawable/ic_launcher_foreground_logo" />
</adaptive-icon>
